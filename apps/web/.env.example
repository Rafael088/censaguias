# Rewrite /api/* -> API. Lo lee next.config.ts al construir; en Vercel definir antes del build.
# No lleva NEXT_PUBLIC_: solo lo lee Next en el servidor.
API_URL=http://localhost:8787

# Supabase. La clave publicable puede ir al navegador; la service_role nunca
# (va solo en apps/api, nunca con prefijo NEXT_PUBLIC_ — regla 2 del repo).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE
