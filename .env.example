# Copia a apps/api/.env y apps/web/.env.local. Nunca subas los valores reales.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Solo en el backend (apps/api). Nunca en el front.
SUPABASE_SERVICE_ROLE_KEY=

# --- API (apps/api) ---
PORT=8787
# Firma de la sesión de estudiante (cookie). Genera con: openssl rand -base64 32
STUDENT_SESSION_SECRET=
# Origen del front, para CORS y cookies
WEB_ORIGIN=http://localhost:3000
# Dominio del correo sintético del staff (ADR 0006). No necesita existir.
STAFF_EMAIL_DOMAIN=staff.censaguias.app

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
